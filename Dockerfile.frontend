# Multi-stage Dockerfile for building and serving the Vue.js frontend
# Stage 1: Build the application using Node.js
FROM node:24 AS builder

# Set the working directory inside the container for the build process
WORKDIR /app/webui

# Copy the webui directory contents to the working directory
COPY webui ./

# Install project dependencies using Yarn
RUN yarn install

# Build the Vue.js application for production
RUN yarn run build-prod

# Stage 2: Serve the built application using Nginx
FROM nginx:stable

# Copy the built static files from the builder stage to Nginx's default web root
COPY --from=builder /app/webui/dist /usr/share/nginx/html

# Expose port 80 for the web server
EXPOSE 80

# Nginx will automatically start and serve the files on port 80