# Create a first temporary image named "builder"
FROM node:18 AS builder

# Set working directory
WORKDIR /app

# Copy package files
COPY webui/package.json webui/yarn.lock webui/.yarnrc.yml ./
COPY webui/.yarn ./.yarn

# Install dependencies
RUN yarn install

# Copy source code
COPY webui/ ./

# Build the application
RUN yarn build-prod

# Create final container
FROM nginx:stable

# Copy built files from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration (optional)
# COPY nginx.conf /etc/nginx/nginx.conf

# Expose port 80
EXPOSE 80

# How to build and run:
#         docker build -f Dockerfile.frontend -t wasa-frontend .
#         docker run -it --rm -p 8080:80 wasa-frontend
